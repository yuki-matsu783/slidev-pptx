{
  "name": "slidev-addon-pptx",
  "version": "0.1.0",
  "description": "Slidev のスライドを PowerPoint で編集できる PPTX として書き出すアドオン（ネイティブ書き出し）",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "slidev-addon",
    "slidev"
  ],
  "bin": {
    "slidev-pptx": "bin/slidev-pptx.mjs"
  },
  "exports": {
    ".": "./src/export.ts",
    "./*": "./*"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1"
  },
  "peerDependencies": {
    "@slidev/cli": ">=52",
    "playwright-chromium": ">=1.50",
    "vue": "^3.5"
  }
}
